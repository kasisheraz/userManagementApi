{
	"info": {
		"_postman_id": "sumsub-kyc-verification-collection",
		"name": "FinCore - Sumsub KYC Verification Workflow",
		"description": "Complete end-to-end testing for Sumsub KYC verification workflow using mock Sumsub service.\n\n**Test Scenarios:**\n1. User starts KYC workflow\n2. Complete Step 1: User Information\n3. Complete Step 2: Document Verification (Sumsub Mock)\n4. Admin simulates approval/rejection\n5. Complete Step 3: Questionnaire\n6. Complete Step 4: Review & Submit\n7. Check verification status\n\n**Prerequisites:**\n- Backend running with 'npe' or 'local' profile (mock Sumsub enabled)\n- Valid JWT tokens for Business User and Admin\n- Test user and admin accounts created\n\n**Collection Variables:**\n- `base_url`: API base URL (e.g., http://localhost:8080)\n- `jwt_token`: Business user JWT token\n- `admin_token`: Admin JWT token\n- `verification_id`: KYC verification ID (auto-set)\n- `sumsub_applicant_id`: Sumsub applicant ID (auto-set)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
