		{
			"name": "2. Start KYC Workflow",
			"item": [
				{
					"name": "Start FULL KYC Verification",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Verification created with ID\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.verificationId).to.be.a('number');",
									"    pm.expect(jsonData.sumsubApplicantId).to.include('MOCK_');",
									"    pm.collectionVariables.set('verification_id', jsonData.verificationId);",
									"    pm.collectionVariables.set('sumsub_applicant_id', jsonData.sumsubApplicantId);",
									"});",
									"",
									"pm.test(\"Workflow status initialized\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.steps).to.exist;",
									"    pm.expect(jsonData.steps.USER_INFORMATION).to.be.false;",
									"    pm.expect(jsonData.steps.DOCUMENT_VERIFICATION).to.be.false;",
									"});",
									"",
									"var verificationId = pm.response.json().verificationId;",
									"var applicantId = pm.response.json().sumsubApplicantId;",
									"console.log('✅ KYC workflow started successfully');",
									"console.log('📋 Verification ID: ' + verificationId);",
									"console.log('🎭 Mock Sumsub Applicant ID: ' + applicantId);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/kyc/workflow/start?level=FULL",
							"host": ["{{base_url}}"],
							"path": ["api", "kyc", "workflow", "start"],
							"query": [
								{
									"key": "level",
									"value": "FULL"
								}
							]
						},
						"description": "Starts a FULL KYC verification workflow. This creates a mock Sumsub applicant automatically."
					},
					"response": []
				},
