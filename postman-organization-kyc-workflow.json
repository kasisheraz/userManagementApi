    {
      "name": "4. Admin Approval",
      "description": "Admin approves organization (Happy Path)",
      "item": [
        {
          "name": "Switch to Admin Token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Temporarily use admin token for this request",
                  "pm.request.headers.add({",
                  "    key: 'Authorization',",
                  "    value: 'Bearer ' + pm.collectionVariables.get('admin_token')",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Verify admin token is valid"
          }
        },
        {
          "name": "Approve Organization",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Use admin token",
                  "pm.request.headers.add({",
                  "    key: 'Authorization',",
                  "    value: 'Bearer ' + pm.collectionVariables.get('admin_token')",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Organization approved', () => {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.organisationStatus).to.eql('ACTIVE');",
                  "    pm.expect(jsonData.reasonDescription).to.be.oneOf([null, '']);",
                  "    console.log('Organization approved and ACTIVE');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/organizations/{{org_id}}/approve",
              "host": ["{{base_url}}"],
              "path": ["api", "organizations", "{{org_id}}", "approve"]
            },
            "description": "Admin approves organization (status: UNDER_REVIEW → ACTIVE, all documents: VERIFIED)"
          }
        },
        {
          "name": "Verify Documents VERIFIED After Approval",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('All documents are VERIFIED', () => {",
                  "    pm.response.to.have.status(200);",
