                  "        pm.expect(doc.documentStatus).to.eql('VERIFIED');",
                  "        pm.expect(doc.reasonDescription).to.be.oneOf([null, '']);",
                  "    });",
                  "    console.log('All documents VERIFIED, no rejection feedback');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/organizations/{{org_id}}/kyc-documents",
              "host": ["{{base_url}}"],
              "path": ["api", "organizations", "{{org_id}}", "kyc-documents"]
            },
            "description": "Verify all documents are VERIFIED after approval"
          }
        }
      ]
    },
    {
      "name": "5. Admin Rejection (Document-Level)",
      "description": "Admin rejects specific documents with feedback",
      "item": [
        {
          "name": "Reject Organization with Document Feedback",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Use admin token",
                  "pm.request.headers.add({",
                  "    key: 'Authorization',",
                  "    value: 'Bearer ' + pm.collectionVariables.get('admin_token')",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Organization rejected with feedback', () => {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.organisationStatus).to.eql('REQUIRES_RESUBMISSION');",
                  "    pm.expect(jsonData.reasonDescription).to.include('rejected');",
                  "    console.log('Rejection summary:', jsonData.reasonDescription);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentRejections\": [\n    {\n      \"documentId\": {{doc_id_1}},\n      \"rejectionReason\": \"The document is blurry and unreadable. Please upload a clearer version showing company name and registration number.\"\n    },\n    {\n      \"documentId\": {{doc_id_2}},\n      \"rejectionReason\": \"This document is more than 3 months old. Please provide a recent utility bill or bank statement dated within the last 90 days.\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/organizations/{{org_id}}/reject",
