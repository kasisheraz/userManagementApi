    {
      "name": "3. Submit for Review",
      "description": "User submits organization for admin review",
      "item": [
        {
          "name": "Submit Organization for Review",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Organization submitted', () => {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.organisationStatus).to.eql('UNDER_REVIEW');",
                  "    console.log('Organization is now UNDER_REVIEW');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/organizations/{{org_id}}/submit",
              "host": ["{{base_url}}"],
              "path": ["api", "organizations", "{{org_id}}", "submit"]
            },
            "description": "Submit organization for admin review (changes status from PENDING to UNDER_REVIEW, all documents also set to UNDER_REVIEW)"
          }
        },
        {
          "name": "Verify Documents Status After Submit",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('All documents are UNDER_REVIEW', () => {",
                  "    pm.response.to.have.status(200);",
                  "    var docs = pm.response.json();",
                  "    var content = docs.content || docs;",
                  "    content.forEach(doc => {",
                  "        pm.expect(doc.documentStatus).to.eql('UNDER_REVIEW');",
                  "    });",
                  "    console.log('All', content.length, 'documents are UNDER_REVIEW');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/organizations/{{org_id}}/kyc-documents",
              "host": ["{{base_url}}"],
              "path": ["api", "organizations", "{{org_id}}", "kyc-documents"]
            },
            "description": "Verify all documents status changed to UNDER_REVIEW"
          }
        }
