                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('doc_id_1', jsonData.id);",
                  "    console.log('Document 1 ID saved:', jsonData.id);",
                  "    pm.test('Document uploaded', () => {",
                  "        pm.response.to.have.status(201);",
                  "        pm.expect(jsonData.documentStatus).to.eql('PENDING');",
                  "        pm.expect(jsonData.documentType).to.eql('CERTIFICATE_OF_INCORPORATION');",
